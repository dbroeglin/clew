# Authenticate with Entra ID, for example using `az login`.
# Do not put API keys or learner records in this file.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://YOUR-DI-RESOURCE.cognitiveservices.azure.com
AZURE_AI_PROJECT_ENDPOINT=https://YOUR-FOUNDRY-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT
AZURE_OPENAI_DEPLOYMENT=YOUR-VISION-AND-STRUCTURED-OUTPUT-DEPLOYMENT

# Alternatively, unset AZURE_AI_PROJECT_ENDPOINT and supply a resource v1 URL:
# AZURE_OPENAI_BASE_URL=https://YOUR-RESOURCE.openai.azure.com/openai/v1/
